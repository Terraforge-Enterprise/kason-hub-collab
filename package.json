{
  "name": "kason-hub",
  "version": "0.3.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "dev:lan": "bash scripts/dev-lan.sh",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "backfill:unit-month-ledger": "tsx scripts/backfill-unit-month-ledger.ts",
    "db:generate": "npm run prisma:generate -w @kason/db",
    "db:migrate": "npm run prisma:migrate:dev -w @kason/db",
    "db:seed": "npm run prisma:seed -w @kason/db"
  },
  "devDependencies": {
    "dotenv": "^17.4.1",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  },
  "description": "Kason Hub monorepo (Turborepo, Vite web, Hono API)",
  "packageManager": "npm@10.9.4"
}
