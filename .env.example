# ─── Database ────────────────────────────────────────────────────────────────
# PostgreSQL connection string. Create the database first:
#   createdb -U postgres kaenproperties
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaenproperties?schema=public"

# ─── Authentication ──────────────────────────────────────────────────────────
# Secret key for signing JWT session tokens. Must be at least 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-to-a-random-string-at-least-32-chars"

# ─── Application ─────────────────────────────────────────────────────────────
# Public URL of the application (used for links in emails, verification URLs, etc.)
APP_URL="http://localhost:3000"

# Directory for file uploads (relative or absolute path)
UPLOAD_DIR="./uploads"

# ─── Email (AWS SES) ──────────────────────────────────────────────────────
# AWS SES for sending notification emails. Leave blank to disable email.
SES_REGION=ap-southeast-5
SES_FROM_EMAIL=noreply@kaenproperties.com
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase connection credentials (for development and production)
SUPABASE_URL=
# Used by the web client (browser) only — API reads SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Storage bucket for listing photos/videos (private, same region as DB)
SUPABASE_STORAGE_BUCKET=listing-media
# Signed URL TTL in seconds (upload + download). Default 1800 (30 min).
# Listing media is non-sensitive marketing content; longer TTLs reduce
# re-signing churn. If you lower this, also lower the portal's staleTime
# hint at apps/web/src/pages/portal/unit-detail-page.tsx so the cache
# refreshes before the URL expires.
STORAGE_URL_TTL_SEC=1800

# ─── WhatsApp (Meta Cloud API) ───────────────────────────────────────────────
WHATSAPP_PROVIDER=stub                 # "meta" in staging+prod
META_WHATSAPP_PHONE_ID=                # numeric phone-number ID from WABA
META_WHATSAPP_BUSINESS_ID=             # WABA ID
META_WHATSAPP_ACCESS_TOKEN=            # System User access token (long-lived)
META_WHATSAPP_APP_SECRET=              # for HMAC verifying webhook payloads (Phase 2)
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=    # any random string; mirror in Meta dashboard
APP_BASE_URL=https://app.example.com

# --- Phase-2 feature flags (default OFF; foundation §4). API reads these names;
# --- the web bundle reads VITE_-prefixed twins (e.g. VITE_ENABLE_PHASE2_METER).
# ENABLE_PHASE2_TENANT_TRACKER=true
# ENABLE_PHASE2_INVOICE=true
# ENABLE_PHASE2_METER=true              # API: unlock /api/meter (per-request 404 gate)
# VITE_ENABLE_PHASE2_METER=true         # web: show /leasing/meter route + nav
ENABLE_PHASE2_MULTI_PAY=false           # M3 multi-invoice one-transaction payment
VITE_ENABLE_PHASE2_MULTI_PAY=false      # M3 multi-invoice payment UI
# ENABLE_PHASE2_FPX=true
# ENABLE_PHASE2_AUTODRAFT=true
# ENABLE_PHASE2_OWNER_BILLING=true
# ENABLE_PHASE2_TASKS=true
# ENABLE_PHASE2_PWA_PUSH=true

# ── Integration tests ─────────────────────────────────────────────────────────
# Integration suites (RUN_INTEGRATION=1) run HERE, never against the dev database.
# Several bills-grid suites adopt whatever `organization.findFirstOrThrow()` returns and
# tear down against it, so pointing them at a dev DB can delete real grid entries,
# expenses, bearer configs and seeded categories. apps/api/vitest.config.ts redirects
# DATABASE_URL to this value for integration runs, and warns loudly if it is unset.
#
#   createdb kaenproperties_test
#   cd packages/db && DATABASE_URL="$TEST_DATABASE_URL" npx prisma migrate deploy
#   DATABASE_URL="$TEST_DATABASE_URL" npx tsx scripts/seed-test-db.ts
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kaenproperties_test?schema=public"
