# ─────────────────────────────────────────────────────────────────────────────
# Kason Hub — local development environment
#
#   cp .env.example .env
#
# Only the REQUIRED block below is needed to boot the app. Everything after it
# is optional: unset integrations fall back to mocks or are skipped entirely,
# so the app runs fine without a single real credential.
#
# NEVER commit .env, and never put a real credential in this file.
# This repository is PUBLIC.
# ─────────────────────────────────────────────────────────────────────────────


# ═══ REQUIRED ════════════════════════════════════════════════════════════════

# Local PostgreSQL. Create the database first:
#   createdb kasonhub
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasonhub?schema=public"

# Signs JWT session tokens. The API refuses to start without it.
# Generate one:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="replace-me-with-a-random-string-of-at-least-32-characters"


# ═══ SERVER ══════════════════════════════════════════════════════════════════

PORT=3001
NODE_ENV=development

# Comma-separated browser origins allowed to call the API.
# Enforced only when NODE_ENV=production — safe to leave as-is locally.
CORS_ORIGINS=http://localhost:5173

# Where the web app is served from. Used to build links in emails and
# redirect targets.
APP_URL=http://localhost:5173
APP_BASE_URL=http://localhost:5173
PUBLIC_APP_BASE_URL=http://localhost:5173
WEB_BASE_URL=http://localhost:5173
APP_WEB_ORIGIN=http://localhost:5173

# Cookie domain for session cookies. Leave BLANK for localhost — setting it to
# anything else stops the browser accepting the session cookie on 127.0.0.1.
COOKIE_DOMAIN=

# Local directory for file uploads.
UPLOAD_DIR="./uploads"

# Optional read-replica connection. Falls back to DATABASE_URL when unset.
DATABASE_URL_READONLY=

# Set to 1 to log every SQL query Prisma issues. Very noisy; useful when
# debugging a slow or unexpected query.
PRISMA_LOG_QUERIES=

# How long audit-log rows are retained, in days.
AUDIT_RETENTION_DAYS=365


# ═══ FEATURE FLAGS (API side) ════════════════════════════════════════════════
#
# All ON below so every screen is reachable while developing. Each flag has a
# VITE_ twin in apps/web/.env — see apps/web/.env.example.
#
# INVARIANT: a VITE_ twin may only be ON when its API flag here is ON. A
# web-ON/API-OFF split makes the UI act as though a feature works while the
# server silently skips it. There is a test that enforces this
# (packages/shared/src/__tests__/flag-twin-parity.test.ts).

ENABLE_PHASE2_TENANT_TRACKER=true
ENABLE_PHASE2_METER=true
ENABLE_PHASE2_MULTI_PAY=true
ENABLE_PHASE2_FPX=true
ENABLE_PHASE2_AUTODRAFT=true
ENABLE_PHASE2_OWNER_BILLING=true
ENABLE_PHASE2_TASKS=true
ENABLE_PHASE2_PWA_PUSH=true
ENABLE_PHASE2_SPRINTS=true
ENABLE_PHASE2_UNIT_ANALYTICS=true
ENABLE_PHASE2_BILLING_DOCS=true
ENABLE_UNIT_MONTH_LEDGER=true
ENABLE_PHASE2_RESERVATION_GATED_TENANCY=true
ENABLE_PHASE2_BILLS_GRID=true
ENABLE_PHASE2_OWNER_STATEMENT_LIVE_LEDGER=true
ENABLE_PHASE2_RENT_RECLASSIFICATION=true
ENABLE_PHASE2_OWNER_REMITTANCE=true
ENABLE_PHASE2_PRIOR_PERIOD_ADJUSTMENT=true
ENABLE_PHASE2_INVOICE_ADJUSTMENTS=true
ENABLE_BILL_EXPENSES_AS_CHARGES=true
ENABLE_GRID_BILLS_ON_OWNER_STATEMENT=true
ENABLE_SUPPLIER_EXPENSES=true
ENABLE_EXPENSE_BILL=true
ENABLE_KAEN_OPEX=true
ENABLE_OWNER_FUNDING_REQUEST=true
ENABLE_OWNER_DOC_NUMBERING=true
ENABLE_CHARGE_NATURE_ROUTING=true
ENABLE_OWNER_STATEMENT_AUTO_ISSUE=false
ENABLE_OWNER_WEB_EXPENSE_HIDE=false
ENABLE_OWNER_STATEMENT_AUTO_SEND=false
ENABLE_TENANCY_DEPOSIT_DOCS=true
ENABLE_PROFORMA_INVOICES=true

# Not part of the Phase-2 registry; separate feature toggles.
ENABLE_LETTING_COMMISSION=true
FEATURE_AGENT_NAMECARD=true


# ═══ OPTIONAL — FILE STORAGE (Supabase) ══════════════════════════════════════
#
# Powers listing photo/video upload. Leave blank to develop without it; the
# rest of the app works, only media upload is unavailable.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-media
SUPABASE_PUBLIC_BUCKET_URL=
SUPABASE_CA_CERT_PATH=

# Signed-URL lifetime in seconds for upload and download. Default 1800 (30 min).
STORAGE_URL_TTL_SEC=1800

# Upload size ceilings, in bytes.
PHOTO_MAX_BYTES=10485760
VIDEO_MAX_BYTES=104857600


# ═══ OPTIONAL — EMAIL (AWS SES) ══════════════════════════════════════════════
#
# Leave blank to disable outbound email entirely.

SES_REGION=ap-southeast-1
SES_FROM_EMAIL=noreply@example.com
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# Set to 1 to write outbound emails to disk instead of sending them.
# Recommended locally — you get to read what would have been sent.
EMAIL_DEV_CAPTURE=1


# ═══ OPTIONAL — WHATSAPP (Meta Cloud API) ════════════════════════════════════
#
# "stub" logs messages instead of sending. Keep it on stub locally.

WHATSAPP_PROVIDER=stub
META_WHATSAPP_PHONE_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WEBHOOK_VERIFY_TOKEN=


# ═══ OPTIONAL — ONLINE BANKING / FPX PAYMENTS ════════════════════════════════
#
# Unset outside production means the MOCK gateway is used, which simulates the
# full payment round-trip with no real money and no gateway account. That is
# what you want locally — leave this block exactly as it is.
#
# Do NOT set FPX_PROVIDER=molpay. That path talks to the live payment gateway
# and needs real merchant credentials. If a task genuinely requires it, stop and
# ask the repository owner.

FPX_PROVIDER=mock

# Signs mock-gateway callbacks so the local round-trip can be verified.
# Any random string works.
FPX_MOCK_SECRET=local-mock-secret

# Live gateway settings — intentionally left blank. Do not fill these in here.
MOLPAY_MERCHANT_ID=
MOLPAY_SECRET_KEY=
MOLPAY_VERIFY_KEY=
MOLPAY_API_URL=
MOLPAY_BASE_URL=
MOLPAY_CHKSTAT_URL=
MOLPAY_RETURN_URL=


# ═══ TESTING ═════════════════════════════════════════════════════════════════
#
# Integration suites run against THIS database, never your dev one. Several of
# them adopt whatever organisation they find and tear down against it, so
# pointing this at a working database will delete real rows.
#
#   createdb kasonhub_test
#   DATABASE_URL="$TEST_DATABASE_URL" npm run db:migrate
#
# Enable with:  RUN_INTEGRATION=1 npm test

TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kasonhub_test?schema=public"
