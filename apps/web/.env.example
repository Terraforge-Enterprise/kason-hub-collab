# ─────────────────────────────────────────────────────────────────────────────
# Kason Hub — web app (Vite) local environment
#
#   cp apps/web/.env.example apps/web/.env
#
# Vite bakes every VITE_* value into the built bundle, so anything here is
# visible to anyone using the app. Never put a secret in this file.
# ─────────────────────────────────────────────────────────────────────────────

# API endpoints. The dev server proxies these paths to the API on :3001,
# so the relative defaults work out of the box.
VITE_API_URL=/api
VITE_PORTAL_API_URL=/portal-api
VITE_PUBLIC_API_BASE=

# Set to 1 to expose the internal design-preview route.
VITE_DESIGN_PREVIEW=

# ════════════ FEATURE FLAGS (web twins) ══════════════════════════════════════
#
# Each mirrors the same-named flag in the repo-root .env.
#
# INVARIANT: a flag here may be true ONLY IF its API twin is also true. A
# web-ON/API-OFF split makes the UI act as though a feature works while the
# server silently skips it. Enforced by
# packages/shared/src/__tests__/flag-twin-parity.test.ts — keep the two in step.

VITE_ENABLE_PHASE2_TENANT_TRACKER=true
VITE_ENABLE_PHASE2_METER=true
VITE_ENABLE_PHASE2_MULTI_PAY=true
VITE_ENABLE_PHASE2_FPX=true
VITE_ENABLE_PHASE2_AUTODRAFT=true
VITE_ENABLE_PHASE2_OWNER_BILLING=true
VITE_ENABLE_PHASE2_TASKS=true
VITE_ENABLE_PHASE2_PWA_PUSH=true
VITE_ENABLE_PHASE2_SPRINTS=true
VITE_ENABLE_PHASE2_UNIT_ANALYTICS=true
VITE_ENABLE_PHASE2_BILLING_DOCS=true
VITE_ENABLE_UNIT_MONTH_LEDGER=true
VITE_ENABLE_PHASE2_RESERVATION_GATED_TENANCY=true
VITE_ENABLE_PHASE2_BILLS_GRID=true
VITE_ENABLE_PHASE2_OWNER_STATEMENT_LIVE_LEDGER=true
VITE_ENABLE_PHASE2_RENT_RECLASSIFICATION=true
VITE_ENABLE_PHASE2_OWNER_REMITTANCE=true
VITE_ENABLE_PHASE2_PRIOR_PERIOD_ADJUSTMENT=true
VITE_ENABLE_PHASE2_INVOICE_ADJUSTMENTS=true
VITE_ENABLE_BILL_EXPENSES_AS_CHARGES=true
VITE_ENABLE_GRID_BILLS_ON_OWNER_STATEMENT=true
VITE_ENABLE_SUPPLIER_EXPENSES=true
VITE_ENABLE_EXPENSE_BILL=true
VITE_ENABLE_KAEN_OPEX=true
VITE_ENABLE_OWNER_FUNDING_REQUEST=true
VITE_ENABLE_OWNER_DOC_NUMBERING=true
VITE_ENABLE_CHARGE_NATURE_ROUTING=true
VITE_ENABLE_OWNER_STATEMENT_AUTO_ISSUE=false
VITE_ENABLE_OWNER_WEB_EXPENSE_HIDE=false
VITE_ENABLE_OWNER_STATEMENT_AUTO_SEND=false
VITE_ENABLE_TENANCY_DEPOSIT_DOCS=true
VITE_ENABLE_PROFORMA_INVOICES=true
