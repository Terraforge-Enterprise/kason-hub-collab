# Server
PORT=3001
NODE_ENV=production

# Auth
SESSION_SECRET=replace-with-strong-random-secret

# Database (Supabase/Postgres)
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Comma-separated allowed origins for browser clients.
# Use * only for local/dev/testing.
CORS_ORIGINS=http://localhost:5173,https://app.kasonhub.com

# Email (AWS SES)
SES_REGION=ap-southeast-5
SES_FROM_EMAIL=noreply@kaenproperties.com
SES_AWS_ACCESS_KEY_ID=
SES_AWS_SECRET_ACCESS_KEY=

# Supabase Storage (listing photos + videos). Service-role key is used
# server-side; SUPABASE_URL points at the project's REST endpoint.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=listing-media
# Signed URL TTL in seconds (upload + download). Default 1800 (30 min).
# Listing media is non-sensitive marketing content; longer TTLs reduce
# re-signing churn. If you lower this, also lower the portal's staleTime
# hint at apps/web/src/pages/portal/unit-detail-page.tsx so the cache
# refreshes before the URL expires.
STORAGE_URL_TTL_SEC=1800

# Origin URL for password-reset links (admin AND portal — same SPA host;
# admin reset URL is APP_URL/reset-password, portal is APP_URL/portal/reset-password).
APP_URL=http://localhost:5173

# Optional dev/test override — when set to "stdout", sendEmail() prints
# the payload to stdout instead of calling SES. Never set in UAT or prod.
# EMAIL_DEV_CAPTURE=stdout
